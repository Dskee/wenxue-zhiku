# ============ 配置模板 ============
# 复制本文件为 .env，填入你自己的密钥后即可运行：
#     cp .env.example .env
# .env 已被 .gitignore 忽略，不会被提交到 GitHub。

# ============ 模型来源与模型名（也可在页面「⚙️ 设置」里改） ============
# 模型来源：siliconflow（硅基流动云端）/ local（本地 Ollama、LM Studio、vLLM）/ custom（自定义）
PROFILE=siliconflow

# 云端 SiliconFlow（硅基流动）——PROFILE=siliconflow 时必填
# 申请地址：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=sk-在此填入你的密钥
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 对话与出题使用的大模型
CHAT_MODEL_NAME=Qwen/Qwen3-8B
# 向量化（embedding）模型
EMBEDDING_MODEL_NAME=BAAI/bge-large-zh-v1.5

# ---------- 本地模型示例（PROFILE=local 时参考） ----------
# ⚠️ 应用跑在 Docker 里时，地址必须用 host.docker.internal，不能用 127.0.0.1（那指容器自己）
#   Ollama（默认 11434）
#     SILICONFLOW_BASE_URL=http://host.docker.internal:11434/v1
#     CHAT_MODEL_NAME=qwen2.5:7b
#     EMBEDDING_MODEL_NAME=bge-m3
#   LM Studio（默认 1234）
#     SILICONFLOW_BASE_URL=http://host.docker.internal:1234/v1
#   vLLM / 其他（默认 8000）
#     SILICONFLOW_BASE_URL=http://host.docker.internal:8000/v1
# 本地服务通常不需要 API Key，留空即可。

# ---------- 向量化可选独立配置 ----------
# 常见需求：对话跑本地、向量化仍用云端（本地往往没装 embedding 模型）。留空 = 跟随上面的地址与 Key
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# SerpAPI 搜索 Key（选填；不填则联网搜索自动走必应抓取回退通道）
# 申请地址：https://serpapi.com/manage-api-key
SERPAPI_KEY=

# 后端地址（前端 Gradio 与 Agent 工具统一从这里取）
BACKEND_URL=http://127.0.0.1:16055

# Agent / 工具调用最长等待秒数
TIME_OUT=300

# 允许跨域访问后端的来源（逗号分隔）
CORS_ORIGINS=http://127.0.0.1:7860,http://localhost:7860

# 单次上传文件大小上限（MB）
MAX_UPLOAD_MB=50

# 可选：接口访问令牌。留空 = 不校验；设置后所有 /chat、/knowledge 接口需带 X-API-Token 头
API_TOKEN=
